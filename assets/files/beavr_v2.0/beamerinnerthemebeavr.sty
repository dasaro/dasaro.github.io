\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerinnerthemebeavr}[2026/10/05 v2.0 Beavr inner theme]

\mode<presentation>
\usefonttheme[onlymath]{serif}
\setbeamertemplate{items}[square]
\setbeamertemplate{sections/subsections in toc}[square]

\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\normalsize,series=\mdseries}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small,shape=\itshape}

\providecommand{\beavrlogo}{logo_univr.png}
\providecommand{\beavrlogowidthtitle}{4.6cm}
\providecommand{\insertbeavremail}{}
\newcommand{\beavremail}[1]{\def\insertbeavremail{#1}}
\setbeamerfont{beavr email}{size=\small}

\makeatletter
\newdimen\beavr@covery
\newdimen\beavr@covertop
\newdimen\beavr@coverbottom
\newdimen\beavr@covergap
\newdimen\beavr@coverright
\beavr@covertop=.19\paperwidth
\beavr@coverbottom=.43\paperwidth
\beavr@covergap=.06\paperwidth
\beavr@coverright=.05\paperwidth

% Follow the diagonal; measure each field before placing the next one.
\newcommand{\beavr@coverfield}[2]{%
  \pgfmathsetlengthmacro{\beavr@coverx}{\beavr@coverbottom+\beavr@covergap
    - (\beavr@coverbottom-\beavr@covertop)*(\beavr@covery/\paperheight)}%
  \node[anchor=north west,inner sep=0pt,align=left,
    text width=\dimexpr\paperwidth-\beavr@coverright-\beavr@coverx\relax]
    (beavr field) at ([xshift=\beavr@coverx,yshift=\beavr@covery]current page.south west)
    {\raggedright #2\par};
  \pgfextracty{\beavr@covery}{\pgfpointdiff
    {\pgfpointanchor{current page}{south west}}
    {\pgfpointanchor{beavr field}{south west}}}%
  \advance\beavr@covery by -#1\relax
}
\defbeamertemplate*{title page}{beavr}{%
  \begin{tikzpicture}[remember picture,overlay]
    \clip (current page.south west) rectangle (current page.north east);
    \fill[bgcolor]
      (current page.south west) -- (current page.north west) --
      ([xshift=\beavr@covertop]current page.north west) --
      ([xshift=\beavr@coverbottom]current page.south west) -- cycle;
    \ifx\beavrlogo\empty\else
      \node[anchor=south west,inner sep=0pt]
        at ([xshift=.12cm,yshift=.12cm]current page.south west)
        {\includegraphics[width=\beavrlogowidthtitle]{\beavrlogo}};
    \fi
    \beavr@covery=.72\paperheight
    \beavr@coverfield{.22cm}{\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle}
    \ifx\insertsubtitle\empty\else
      \beavr@coverfield{.40cm}{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle}
    \fi
    \beavr@coverfield{.20cm}{\usebeamerfont{author}\insertauthor}
    \ifx\insertinstitute\empty\else
      \beavr@coverfield{.20cm}{\usebeamerfont{institute}\insertinstitute}
    \fi
    \ifx\insertbeavremail\empty\else
      \beavr@coverfield{.32cm}{\usebeamerfont{beavr email}\usebeamercolor[fg]{beavr email}%
        \href{mailto:\insertbeavremail}{\texttt{\insertbeavremail}}}
    \fi
    \ifx\insertdate\empty\else
      \beavr@coverfield{.20cm}{\usebeamerfont{date}\insertdate}
    \fi
    \ifx\inserttitlegraphic\empty\else
      \beavr@coverfield{0pt}{\inserttitlegraphic}
    \fi
    \ifdim\beavr@covery<.05\paperheight
      \PackageWarning{beamerinnerthemebeavr}{Cover metadata is too tall; shorten it or reduce the title font}%
    \fi
  \end{tikzpicture}%
  \null
}
\makeatother
\mode<all>
